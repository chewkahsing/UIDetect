{
  "manifest_version": 3,

  "name": "UIDetect",

  "version": "1.0.0",

  "description":
  "Intelligent Browser Extension for Real-time Website Security Assessment",


  "permissions": [

    "activeTab",
    "storage",
    "tabs",
    "contextMenus",
    "notifications",
    "webRequest",
    "scripting",
    "windows"

  ],


   "host_permissions": [

    "<all_urls>",

    "http://127.0.0.1:5000/*"

  ],


  "action": {

    "default_popup":
    "popup/popup.html",

    "default_title":
    "UIDetect"

  },


  "background": {

    "service_worker":
    "scripts/background.js"

  },


  "content_scripts": [

    {

      "matches": [

        "<all_urls>"

      ],


      "js": [

        "scripts/content.js", 
        "scripts/interactionDetector.js",
        "content/scanModal.js"

      ],

      "css": [
        
        "content/scanModal.css"

      ],


      "run_at":
      "document_idle"

    }
    

  ],


  "icons": {

    "16":
    "icons/icon16.png",

    "48":
    "icons/icon48.png",

    "128":
    "icons/icon128.png"

  }

}

